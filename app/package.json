    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.15",
    "@paperclipai/db": "2026.722.0",
    "@paperclipai/server": "2026.722.0",
    "drizzle-orm": "0.45.2"
  }
}
